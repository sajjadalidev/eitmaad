# Copy to .env.local and fill in. Never commit real values.

# Supabase Postgres (use the pooler URL)
DATABASE_URL=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Signs the portal login cookie. At least 32 random characters. Required in production.
SESSION_SECRET=

# Phone hashing pepper (blueprint section 4.4). Long random value.
PHONE_PEPPER_ACTIVE_VERSION=1
PHONE_PEPPER_V1=
