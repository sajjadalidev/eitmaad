# Copy to apps/web/.env.local and fill in. Never commit real values.

# Supabase "Transaction pooler" string (port 6543). Used by the app.
DATABASE_URL=

# Supabase "Session pooler" string (port 5432). Used only to run migrations.
DATABASE_MIGRATION_URL=

# Local development only: set to "postgres" to use DATABASE_URL instead of the in-memory dev store.
# Leave empty to keep local runs away from the real database.
ETIMAAD_STORE=

# Phone hashing pepper (blueprint section 4.4). At least 32 random characters. Required in production.
PHONE_PEPPER_ACTIVE_VERSION=1
PHONE_PEPPER_V1=

# Encrypts API signing secrets stored in the database. At least 32 random characters. Required in production.
SIGNING_SECRET_KEY=

# Signs the portal login cookie. At least 32 random characters. Required in production.
SESSION_SECRET=

# Upstash Redis (not used yet)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (not used yet)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
